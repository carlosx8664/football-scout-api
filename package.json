{
  "name": "football-scout-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:matches": "node scripts/build-match-feed.js",
    "worker:deploy": "wrangler deploy --config workers/dispatch-trigger/wrangler.jsonc",
    "worker:dry-run": "wrangler deploy --config workers/dispatch-trigger/wrangler.jsonc --dry-run",
    "lint": "oxlint",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "playwright": "^1.64.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.151.2"
  }
}
