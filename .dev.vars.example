# Local-only secrets for `wrangler pages dev` / `npm run preview`.
# Copy to `.dev.vars` (gitignored) and fill in real values.

# DeepSeek (https://platform.deepseek.com/api_keys) - powers /api/analysis match write-ups.
DEEPSEEK_API_KEY=
# Optional: model override. Defaults to deepseek-flash.
# DEEPSEEK_MODEL=deepseek-flash

# football-data.org (https://www.football-data.org/client/register) - league tables.
FOOTBALL_DATA_ORG_TOKEN=

# Cloudflare API token with "Workers KV Storage: Edit", plus account and namespace ids.
# Only needed to publish feeds locally instead of via GitHub Actions.
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_API_TOKEN=

# Web Push (phone alerts). Generate a pair with `npm run push:keys`:
# the public half is also served to the browser by GET /api/push/key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional: route DeepSeek calls through Cloudflare AI Gateway instead of api.deepseek.com.
# CF_GATEWAY_ID=
# CF_AIG_TOKEN=
