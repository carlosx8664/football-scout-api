{
  "manifest_version": 3,
  "name": "Odds Autobet",
  "version": "0.2.0",
  "description": "Fills SportyBet and BetBoro betslips from the Oddtor arb feed and the Bet Builder. Never places a bet.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage", "alarms", "sidePanel"],
  "host_permissions": [
    "https://*.sportybet.com/*",
    "https://*.betboro.com.gh/*",
    "https://*.pages.dev/*",
    "http://localhost:8788/*",
    "http://127.0.0.1:8788/*",
    "http://localhost:5173/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Odds Autobet",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": { "default_path": "panel/panel.html" },
  "content_scripts": [
    {
      "matches": ["https://*.sportybet.com/*"],
      "js": ["shared/markets.js", "content/common.js", "content/sportybet.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.betboro.com.gh/*"],
      "js": ["shared/betboro-markets.js", "content/common.js", "content/betboro.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.pages.dev/*", "http://localhost:5173/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
