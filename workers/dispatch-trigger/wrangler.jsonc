{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oddtor-dispatch-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "triggers": {
    // One cron only: `0 */3 * * *` was fully covered by `*/15 * * * *`, so it only queued a
    // duplicate workflow run (and 3 extra KV writes) eight times a day.
    "crons": ["*/15 * * * *"]
  }
}
